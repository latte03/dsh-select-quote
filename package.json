{
  "name": "dsh-select-quote",
  "version": "0.4.3",
  "description": "DeepSeek Harness web plugin: adds selection annotations, in-place translation, sidebar subagent questions and default-browser link opening. The selected text rides along with your next message, the source keeps its highlight and ordinal mark for jumping back, the menu opens on selection or from the right-click menu, and the translation model can be picked separately.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web",
    "quote",
    "annotation",
    "selection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latte03/dsh-select-quote.git"
  },
  "homepage": "https://github.com/latte03/dsh-select-quote#readme",
  "bugs": {
    "url": "https://github.com/latte03/dsh-select-quote/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./typert": "./lib/typert.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/remote.js",
    "lib/typert.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "sync:desktop": "node scripts/sync-desktop.mjs",
    "sync:web": "node scripts/sync-desktop.mjs --profile web",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-bundle.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "release": "pnpm run check && commit-and-tag-version"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3",
    "commit-and-tag-version": "^13.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.23.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
