{
  "name": "dsh-select-quote",
  "version": "0.2.0",
  "description": "DeepSeek Harness web plugin: annotate text selected in the conversation — the selection rides along with your next message, is marked in the source text, and the model points back at it.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web",
    "quote",
    "annotation",
    "selection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latte03/dsh-select-quote.git"
  },
  "homepage": "https://github.com/latte03/dsh-select-quote#readme",
  "bugs": {
    "url": "https://github.com/latte03/dsh-select-quote/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify-bundle.mjs",
    "check": "npm run typecheck && npm run build && npm run verify"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.23.0",
    "typescript": "^5.8.0"
  }
}
